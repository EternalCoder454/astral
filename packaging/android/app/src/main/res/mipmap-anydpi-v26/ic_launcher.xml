<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive icon: Astral's own mark on the deep ink the app is drawn in.

  Android masks the background to whatever shape the launcher uses, so the
  colour is a drawable rather than part of the artwork, and the mark sits at
  two thirds of the 108 unit canvas so no launcher shape can crop it.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
